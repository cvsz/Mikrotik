# zOS Cloudflare integration template
# Copy locally and populate only verified values. Do not commit secrets.

# Controller running cloudflared
CF_CONNECTOR_HOST=core.zeaz.dev

# Public hostname(s) must be explicitly approved before publishing.
CF_PUBLIC_HOSTNAME=

# Private origin, for example http://192.168.1.123:3000
CF_ORIGIN_URL=

# Optional private network route. Keep empty until explicitly reviewed.
CF_PRIVATE_NETWORK=

# Cloudflare identifiers are intentionally unset.
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_TUNNEL_ID=

# NEVER place API tokens or tunnel credentials in this tracked template.
# Supply them through an approved host secret store/environment at runtime.
