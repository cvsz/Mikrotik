# CORE bootstrap/recovery environment example
#
# Usage example:
#   set -a
#   source core/.env
#   set +a
#   sudo --preserve-env=LAN_IFACE,WG_IFACE,LAN_CIDR,GW,SSH_PORT,SSH_ALLOW_PASSWORD,SSH_USER ./core/install.sh
#
# Never commit core/.env with site-specific or sensitive values.

LAN_IFACE=ens33
WG_IFACE=policedbc
LAN_CIDR=192.168.1.0/24
GW=192.168.1.1

SSH_PORT=22
SSH_ALLOW_PASSWORD=no

# Leave blank to let the installer derive SUDO_USER/USER.
SSH_USER=
