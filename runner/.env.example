# Windows zOS self-hosted runner VM environment example
#
# Host role: trusted GitHub Actions runner for cvsz/zos.
# This file is a reference. GitHub Actions Runner does not auto-load it.
# Never store registration tokens, GitHub PATs, private keys, or credentials here.

RUNNER_VM_HOSTNAME=zeaz
RUNNER_NAME=zOS-Runner
RUNNER_ROOT=D:\zOS-Runner
RUNNER_TASK=zOS-GitHub-Runner
RUNNER_REPOSITORY=https://github.com/cvsz/zos
RUNNER_LABELS=self-hosted,Windows,X64
RUNNER_SHELL=pwsh

# Security posture
RUNNER_TRUSTED_ONLY=1
RUNNER_ALLOW_UNTRUSTED_FORKS=0
RUNNER_ALLOW_LIVE_ROUTEROS_APPLY=0
