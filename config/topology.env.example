# ZeaZDev canonical topology
# Copy to config/topology.env and fill values only from verified runtime evidence.

ROUTER_NAME=policedbc
ROUTER_HOST=192.168.1.1
ROUTER_SSH_USER=admin
ROUTER_LAN_CIDR=192.168.1.0/24
ROUTER_LAN_IP=192.168.1.1
ROUTER_WAN_IP=192.168.205.251
ROUTER_WAN_PREFIX=21
ROUTER_UPSTREAM_GW=192.168.200.1
ROUTER_WG_NAME=wg-remote
ROUTER_WG_CIDR=10.8.0.0/24
ROUTER_WG_IP=10.8.0.1
ROUTER_WG_PORT=51820

DEV_FQDN=core.zeaz.dev
DEV_ENV=dev
# Desired automation identity. Existing/recovery hosts may use another explicitly selected account.
DEV_SSH_USER=zeazdev
DEV_WG_IP=10.8.0.2
# CORE LAN is DHCP/runtime evidence. Fill only if a workflow genuinely requires the observed address.
DEV_LAN_IP=
DEV_LAN_IFACE=ens33
DEV_WG_IFACE=policedbc

PROD_FQDN=prod.zeaz.dev
PROD_ENV=production
PROD_SSH_USER=zeazdev
# Set only after verified from the production host/router.
PROD_LAN_IP=
PROD_WG_IP=
PROD_LAN_IFACE=ens33

ROUTEROS_UPDATE_CHANNEL=stable
ROUTEROS_UPDATE_NOTIFY_URL=
ROUTEROS_UPDATE_NOTIFY_TOKEN=
OMEGA_AUTO_ROUTEROS_UPDATE=0
OMEGA_ALLOW_ROUTER_REBOOT=0

OMEGA_REQUIRE_DRY_RUN=1
OMEGA_REQUIRE_SAFE_MODE=1
OMEGA_ALLOW_LIVE_APPLY=0
